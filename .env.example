# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel se cargan en Project Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Clave secreta (service_role / secret). Solo en el servidor: nunca con NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la tienda (para los links de los mails y de Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://pianura-tienda.vercel.app

# Mercado Pago (opcional). Si está vacío, la tienda ofrece solo transferencia.
MP_ACCESS_TOKEN=
